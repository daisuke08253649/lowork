VITE_API_BASE_URL=http://127.0.0.1:8000
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=5
DATABASE_URL=sqlite+aiosqlite:///backend/data/chat.db
CHROMA_DB_PATH=backend/data/chroma_db
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# 手動でuvicornを起動して `npm run dev`（http://localhost:1420）から使うときは、
# シェルで LOWORK_ALLOW_DEV_ORIGIN=1 を付けて起動する（例: LOWORK_ALLOW_DEV_ORIGIN=1 uvicorn backend.main:app --port 8000）。
# 本番の起動でも読み込まれるため、この.envには書かないこと。
